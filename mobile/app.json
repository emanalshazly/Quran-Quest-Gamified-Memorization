{
  "name": "QuranQuest",
  "displayName": "Quran Quest",
  "description": "Gamified Quran Memorization for Kids",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#2E7D32"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.quranquest.app",
    "infoPlist": {
      "NSMicrophoneUsageDescription": "Quran Quest needs access to your microphone to record your Quran recitation.",
      "NSCameraUsageDescription": "Quran Quest needs access to your camera for profile pictures.",
      "NSPhotoLibraryUsageDescription": "Quran Quest needs access to your photo library for profile pictures."
    }
  },
  "android": {
    "package": "com.quranquest.app",
    "versionCode": 1,
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#2E7D32"
    },
    "permissions": [
      "RECORD_AUDIO",
      "WRITE_EXTERNAL_STORAGE",
      "READ_EXTERNAL_STORAGE",
      "CAMERA"
    ]
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": [
    "**/*"
  ]
}
